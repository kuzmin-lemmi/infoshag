---
// Выбор темы сайта: светлая или тёмная. Тот же выбор, что у кнопки в шапке, — игры открываются в выбранной теме.
const themes = [
  { id: 'light', label: 'Светлая', colors: ['#F3F0F6', '#6A4FB5', '#17151C'] },
  { id: 'dark', label: 'Тёмная', colors: ['#17151C', '#B49BFF', '#F1EDF5'] },
];
---
<div class="group" role="radiogroup" aria-label="Тема">
  {themes.map(t => (
    <button type="button" role="radio" aria-checked="false" data-theme-pick={t.id}>
      <span class="sw" aria-hidden="true">{t.colors.map(c => <i style={`background:${c}`}></i>)}</span>
      {t.label}
    </button>
  ))}
</div>

<script>
  const root = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const theme = () => root.dataset.theme ?? (mq.matches ? 'dark' : 'light');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-pick]')];
  const sync = () => buttons.forEach(b => b.setAttribute('aria-checked', String(b.dataset.themePick === theme())));
  buttons.forEach(b => b.addEventListener('click', () => {
    root.dataset.theme = b.dataset.themePick!;
    try { localStorage.setItem('theme', b.dataset.themePick!); } catch {}
    dispatchEvent(new Event('themechange'));
  }));
  addEventListener('themechange', sync);
  mq.addEventListener('change', sync);
  sync();
</script>

<style>
  .group{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
  .group button{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:.5em 1em .5em .6em;border-radius:12px;
    border:1.5px solid var(--line);background:var(--surface);color:var(--ink);font:700 15px var(--body);cursor:pointer;
    transition:transform 160ms var(--ease-out),border-color 160ms var(--ease-out)}
  .group button[aria-checked="true"]{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent) inset}
  .group button:active{transform:scale(.97)}
  .sw{display:inline-flex;border-radius:8px;overflow:hidden;border:1px solid var(--line)}
  .sw i{width:12px;height:24px}
  @media (prefers-reduced-motion:reduce){ .group button{transition:none} .group button:active{transform:none} }
</style>
