---
// Своя страница «не найдено»: GitHub Pages отдаёт её на любой несуществующий адрес сайта
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { getCollection } from 'astro:content';
import { klassHref, klassName } from '../lib';
import { SITE } from '../config';
const base = import.meta.env.BASE_URL;
const school = (await getCollection('items')).filter(i => i.data.type === 'game' || i.data.type === 'trainer');
const grades = SITE.grades.filter(g => school.some(i => i.data.grades.includes(g)));
---
<Base title="Страница не найдена" description="Такой страницы на сайте нет — загляни в каталог игр." noindex>
  <section class="nf">
    <div class="wrap">
      <Logo size={72} />
      <p class="code">404</p>
      <h1>Такой страницы нет</h1>
      <p class="lead">Возможно, ссылка устарела или в адресе опечатка. Все игры и тренажёры — в каталоге.</p>
      <div class="cta">
        <a class="btn primary" href={`${base}catalog/`}>Открыть каталог</a>
        <a class="btn" href={base}>На главную</a>
      </div>
      <p class="muted">По классам: {grades.map((g, i) => <>{i > 0 && ' · '}<a href={klassHref(g)}>{klassName(g)}</a></>)}</p>
    </div>
  </section>
</Base>
<script>
  // старые ссылки вида github.io/personal_ebsite/… приходят сюда как /personal_ebsite/… — переводим на новый адрес
  const old = '/personal_ebsite/';
  if (location.pathname.startsWith(old)) location.replace('/' + location.pathname.slice(old.length) + location.search + location.hash);
</script>

<style>
  .nf{padding:clamp(48px,8vw,96px) 0;text-align:center}
  .code{font:800 clamp(64px,12vw,128px)/1 var(--display);letter-spacing:-.04em;margin:12px 0 0;
    background:var(--brand);-webkit-background-clip:text;background-clip:text;color:transparent}
  .lead{color:var(--soft);font-size:18px;max-width:46ch;margin:0 auto 22px}
  .cta{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:22px}
  .nf a:not(.btn){color:var(--accent);font-weight:600}
</style>
