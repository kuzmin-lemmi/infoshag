---
// Карточка на полке витрины: превью оживает при наведении
import Preview from './Preview.astro';
import { ACCESS } from '../config';
import { playHref, pageHref, gradeLabel, downloadHref, downloadName } from '../lib';
const { item } = Astro.props;
const d = item.data;
const external = /^https?:/.test(d.url);
const dl = downloadHref(d);
---
<article class="sc" style={`--c:${d.color}`} data-pv-host>
  <a class="media" href={pageHref(item.id)} aria-label={d.title}><Preview item={item} /></a>
  <div class="body">
    <p class="meta">
      {d.grades.length > 0 ? gradeLabel(d.grades) : d.type === 'course' ? 'Курс' : 'Программа'}
      {d.duration && <> · {d.duration}</>}
      {d.access !== 'free' && <> · {ACCESS[d.access]}</>}
    </p>
    <h3><a href={pageHref(item.id)}>{d.title}</a></h3>
    {d.topic && <p class="topic">{d.topic}</p>}
    <div class="act">
      <a class="play" href={playHref(item)} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
        {external ? 'Открыть ↗' : '▶ Играть'}
      </a>
      {dl && <a class="dl" href={dl} download={downloadName(d.url)} title="Скачать игру бесплатно — один HTML-файл">⬇ Скачать</a>}
    </div>
  </div>
</article>

<style>
  .sc{display:flex;flex-direction:column;min-width:0;background:var(--surface);border:1.5px solid var(--line);border-radius:14px;overflow:hidden;
    transition:box-shadow .2s,border-color .2s}
  .sc:hover{border-color:var(--c);box-shadow:0 10px 26px color-mix(in srgb,var(--c) 24%,transparent)}
  .media{display:block;border-radius:12px 12px 0 0;overflow:hidden}
  .body{display:flex;flex-direction:column;gap:2px;padding:10px 12px 12px;flex:1}
  .meta{margin:0;font-size:12.5px;font-weight:600;color:var(--soft)}
  h3{margin:.2em 0 0;font-size:15px;line-height:1.25}
  h3 a{text-decoration:none}
  .topic{margin:0;color:var(--soft);font-size:13.5px;line-height:1.4;flex:1}
  .act{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
  .dl{font-weight:700;text-decoration:none;color:var(--ink);border:1.5px solid var(--line);padding:calc(.35em - 1.5px) .7em;border-radius:8px;font-size:13.5px}
  .dl:hover{border-color:var(--c)}
  .play{font-weight:700;text-decoration:none;color:#fff;background:var(--c);
    padding:.35em .8em;border-radius:8px;font-size:13.5px}
  .play:hover{filter:brightness(1.1)}
  @media (prefers-reduced-motion:reduce){ .sc{transition:none} }
</style>
