---
// Заголовок, описание и превью ссылки для ВК, мессенджеров и поисковиков
interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const { title, description, image = 'og/infoshag.jpg', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const abs = (p: string) => new URL(p, Astro.site).toString();
const imageUrl = abs(base + image);
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={abs(Astro.url.pathname)} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Инфошаг" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(Astro.url.pathname)} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={imageUrl} />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
