---
import Base from '../layouts/Base.astro';
import Preview from '../components/Preview.astro';
import ShelfCard from '../components/ShelfCard.astro';
import { getCollection } from 'astro:content';
import { SITE, ACCESS } from '../config';
import { openHref, pageHref, gradeLabel, klassHref, klassName } from '../lib';
const all = (await getCollection('items')).sort((a, b) => a.data.order - b.data.order);
const school = all.filter(i => i.data.type === 'game' || i.data.type === 'trainer');
const grades = [...new Set(school.flatMap(i => i.data.grades))].sort((a, b) => a - b);
const more = all.filter(i => i.data.type === 'course' || i.data.type === 'app');
const hero = school.find(i => i.data.featured) ?? school[0];
const h = hero.data;
---
<Base>
  <section class="hero" style={`--c:${h.color}`}>
    <div class="wrap hero-in">
      <div class="txt">
        <p class="kicker">{SITE.short} · игры для уроков информатики</p>
        <h1>{h.emoji} {h.title}</h1>
        <p class="lead">{h.summary}</p>
        <p class="facts">
          {gradeLabel(h.grades) && <span>{gradeLabel(h.grades)}</span>}
          {h.duration && <span>⏱ {h.duration}</span>}
          <span>{ACCESS[h.access]}</span>
        </p>
        <div class="cta">
          <a class="btn primary big" href={openHref(h.url)}>▶ Играть</a>
          <a class="btn big" href={pageHref(hero.id)}>Как использовать на уроке</a>
        </div>
      </div>
      <a class="screen" href={pageHref(hero.id)} aria-label={h.title}><Preview item={hero} load="visible" /></a>
    </div>
  </section>

  <section class="pick">
    <div class="wrap">
      <h2>Уроки по классам</h2>
      <div class="tiles">
        {grades.map(g => {
          const n = school.filter(i => i.data.grades.includes(g)).length;
          return (
            <a class="tile" href={klassHref(g)}>
              <b>{g}</b>
              <span>{klassName(g)}</span>
              <small>{n} {n === 1 ? 'игра' : n < 5 ? 'игры' : 'игр'} по порядку учебника →</small>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {grades.map(g => (
    <section class="shelf">
      <div class="wrap">
        <div class="head"><h2>{klassName(g)}</h2><a href={klassHref(g)}>Все уроки {g} класса →</a></div>
        <div class="cards">
          {school.filter(i => i.data.grades.includes(g)).map(i => <ShelfCard item={i} />)}
        </div>
      </div>
    </section>
  ))}

  {more.length > 0 && (
    <section class="shelf">
      <div class="wrap">
        <div class="head"><h2>Курсы и программы</h2><a href={SITE.github}>Все проекты на GitHub ↗</a></div>
        <div class="cards">{more.map(i => <ShelfCard item={i} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero{padding:clamp(20px,3vw,36px) 0;background:
    radial-gradient(ellipse at 80% 10%,color-mix(in srgb,var(--c) 26%,transparent),transparent 60%),
    color-mix(in srgb,var(--c) 7%,var(--bg))}
  .hero-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(20px,3.5vw,44px);align-items:center}
  .kicker{font-weight:700;color:var(--soft);text-transform:uppercase;letter-spacing:.08em;font-size:12px;margin:0 0 10px}
  h1{font-size:clamp(24px,3vw,36px)}
  .lead{font-size:16px;color:var(--soft);margin:0 0 12px;max-width:46ch}
  .facts{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0 0 18px;font-weight:600;font-size:15px}
  .cta{display:flex;gap:8px;flex-wrap:wrap}
  .big{padding:.65em 1.1em;font-size:15px}
  .hero .primary{background:var(--c);border-color:var(--c);color:#fff}
  .screen{display:block;width:100%;max-width:560px;justify-self:end;border-radius:calc(var(--r) + 2px);overflow:hidden;border:5px solid var(--surface);
    box-shadow:0 24px 50px color-mix(in srgb,var(--c) 30%,transparent),0 3px 10px rgba(0,0,0,.12)}

  .pick{padding-bottom:0}
  .pick h2{font-size:clamp(18px,1.8vw,22px)}
  .tiles{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))}
  .tile{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:14px;align-items:center;
    padding:12px 16px;border-radius:14px;background:var(--surface);border:1.5px solid var(--line);text-decoration:none;transition:border-color .2s}
  .tile:hover{border-color:var(--accent)}
  .tile b{grid-row:span 2;font:800 32px/1 var(--display);color:var(--accent)}
  .tile span{font-weight:700;font-size:16px}
  .tile small{color:var(--soft);font-size:13px}

  .shelf{padding-bottom:0}
  .head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .head h2{margin:0;font-size:clamp(18px,1.8vw,22px)}
  .head a{font-weight:600;font-size:15px;color:var(--accent);text-decoration:none}
  /* сетка без прокрутки: на широком экране 4–5 карточек в ряд, дальше переносится */
  .cards{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(min(100%,200px),1fr))}

  @media (max-width:820px){
    .hero-in{grid-template-columns:1fr}
    .screen{order:-1;justify-self:stretch;max-width:none}
  }
  @media (prefers-reduced-motion:reduce){ .tile{transition:none} }
</style>
