---
import { TYPES, ACCESS } from '../config';
import { openHref, pageHref, gradeLabel, downloadHref, downloadName } from '../lib';
const { item } = Astro.props;
const d = item.data;
const external = /^https?:/.test(d.url);
const dl = downloadHref(d);
---
<article class="card" style={`--c:${d.color}`}
  data-type={d.type} data-grades={d.grades.join(' ')}
  data-text={[d.title, d.summary, d.topic ?? '', ...d.tags].join(' ').toLowerCase()}>
  <a class="cover" href={pageHref(item.id)} aria-label={d.title}><span>{d.emoji}</span></a>
  <div class="body">
    <div class="meta">
      <span class="chip">{TYPES[d.type].label}</span>
      {d.grades.length > 0 && <span class="chip">{gradeLabel(d.grades)}</span>}
      {d.access !== 'free' && <span class="chip">{ACCESS[d.access]}</span>}
    </div>
    <h3><a href={pageHref(item.id)}>{d.title}</a></h3>
    {d.topic && <p class="topic">{d.topic}</p>}
    <p class="sum">{d.summary}</p>
    <div class="act">
      <a class="btn primary" href={openHref(d.url)} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
        {d.type === 'course' ? 'К курсу' : 'Открыть'} {external ? '↗' : '▶'}
      </a>
      {dl && <a class="btn" href={dl} download={downloadName(d.url)}>⬇ Скачать</a>}
      <a class="btn" href={pageHref(item.id)}>Подробнее</a>
    </div>
  </div>
</article>
<style>
  .card{display:flex;flex-direction:column;background:var(--surface);border:1.5px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .15s,box-shadow .15s}
  .card:hover{transform:translateY(-3px);box-shadow:0 14px 34px color-mix(in srgb,var(--c) 22%,transparent)}
  .card[hidden]{display:none}
  .cover{display:grid;place-items:center;height:132px;text-decoration:none;
    background:radial-gradient(circle at 30% 20%,color-mix(in srgb,var(--c) 55%,#fff),var(--c))}
  .cover span{font-size:62px;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25))}
  .body{display:flex;flex-direction:column;gap:6px;padding:16px 18px 18px;flex:1}
  .meta{display:flex;gap:6px;flex-wrap:wrap}
  h3{margin:.3em 0 0}
  h3 a{text-decoration:none}
  .topic{margin:0;font-weight:600;color:var(--c);filter:saturate(1.2)}
  .sum{margin:0;color:var(--soft);font-size:15.5px;flex:1}
  .act{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
  .act .btn{padding:.55em .95em;font-size:15px}
  .act .btn.primary{background:var(--c);border-color:var(--c);color:#fff}
</style>
