---
import Base from '../layouts/Base.astro';
import Preview from '../components/Preview.astro';
import ShelfCard from '../components/ShelfCard.astro';
import Rail from '../components/Rail.astro';
import Logo from '../components/Logo.astro';import { Picture } from 'astro:assets';
import heroArt from '../assets/infoshag-hero.png';
import { getCollection } from 'astro:content';
import { SITE, ACCESS, SCHOOL_TYPES } from '../config';
import { playHref, pageHref, gradeLabel, klassHref, klassName, colorVars } from '../lib';
const all = (await getCollection('items')).sort((a, b) => a.data.order - b.data.order);
const school = all.filter(i => SCHOOL_TYPES.includes(i.data.type));
const grades = SITE.grades;
const filled = grades.filter(g => school.some(i => i.data.grades.includes(g)));   // полки — только для классов с материалами
const more = all.filter(i => i.data.type === 'course' || i.data.type === 'app');
// «Новое» — последний опубликованный материал (по полю added), при равных датах — отмеченный featured
const time = (i: typeof all[number]) => i.data.added?.getTime() ?? 0;
const hero = [...all].sort((a, b) => time(b) - time(a) || Number(b.data.featured) - Number(a.data.featured))[0];
const h = hero.data;
const heroExternal = /^https?:/.test(h.url);
const added = h.added?.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
---
<Base>
  <section class="brand">
    <svg class="deco" viewBox="0 0 600 400" preserveAspectRatio="xMinYMid slice" aria-hidden="true">
      <circle cx="40" cy="60" r="90" /><circle cx="520" cy="380" r="120" /><circle cx="300" cy="40" r="10" class="dot" />
      <path d="M0 330H120L160 290H330" /><circle cx="334" cy="290" r="6" class="dot" />
      <path d="M210 0V40L250 80H420" /><circle cx="424" cy="80" r="6" class="dot" />
    </svg>
    <div class="wrap brand-in">
      <div class="txt">
        <Logo size={88} class="big-logo" />
        <h1>{SITE.short}</h1>
        <p class="lead">Игры и тренажёры<br />по&nbsp;информатике</p>
        <p class="sub">{SITE.sub}</p>
      </div>
      <Picture class="art" src={heroArt} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[420, 848]} sizes="(max-width: 820px) 100vw, 48vw" alt="" loading="eager" />
    </div>
  </section>

  <section class="feat" style={colorVars(h.color)}>
    <div class="wrap">
      <div class="feat-in">
        <a class="screen" href={pageHref(hero.id)} aria-label={h.title}><Preview item={hero} load="visible" /></a>
        <div>
          <p class="kicker">Новое{added && <> · {added}</>}</p>
          <h2>{h.emoji} {h.title}</h2>
          <p class="lead2">{h.summary}</p>
          <p class="facts">
            {gradeLabel(h.grades) && <span>{gradeLabel(h.grades)}</span>}
            {h.duration && <span>⏱ {h.duration}</span>}
            <span>{ACCESS[h.access]}</span>
          </p>
          <div class="cta">
            <a class="btn primary" href={playHref(hero)} target={heroExternal ? '_blank' : undefined} rel={heroExternal ? 'noopener' : undefined}>
              {heroExternal ? 'Открыть ↗' : h.type === 'guide' ? '▶ Открыть' : '▶ Играть'}
            </a>
            <a class="btn" href={pageHref(hero.id)}>Подробнее</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pick">
    <div class="wrap">
      <h2>Уроки по классам</h2>
      <div class="tiles">
        {grades.map(g => (
          <a class={`tile${filled.includes(g) ? '' : ' empty'}`} href={klassHref(g)}>
            <b>{g}</b>
            <span>{!filled.includes(g) ? 'скоро' : g === 9 ? 'класс · ОГЭ' : g === 11 ? 'класс · ЕГЭ' : 'класс'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {filled.map(g => (
    <section class="shelf">
      <div class="wrap">
        <div class="head"><h2>{klassName(g)}</h2><a href={klassHref(g)}>Все уроки {g} класса →</a></div>
        <Rail label={`${klassName(g)}: материалы`}>
          {school.filter(i => i.data.grades.includes(g)).map(i => <ShelfCard item={i} />)}
        </Rail>
      </div>
    </section>
  ))}

  {more.length > 0 && (
    <section class="shelf">
      <div class="wrap">
        <div class="head"><h2>Курсы и программы</h2><a href={SITE.github}>Все проекты на GitHub ↗</a></div>
        <Rail label="Курсы и программы">{more.map(i => <ShelfCard item={i} />)}</Rail>
      </div>
    </section>
  )}
</Base>

<style>
  .brand{position:relative;overflow:hidden;padding:0;background:
    radial-gradient(circle at 12% 20%,color-mix(in srgb,var(--accent) 14%,transparent),transparent 45%),
    linear-gradient(180deg,var(--tint),var(--bg))}
  .deco{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .deco circle{fill:color-mix(in srgb,var(--accent) 8%,transparent)}
  .deco path{fill:none;stroke:color-mix(in srgb,var(--accent) 40%,transparent);stroke-width:2}
  .deco .dot{fill:color-mix(in srgb,var(--accent) 45%,transparent)}
  .brand-in{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.95fr);align-items:center;gap:clamp(12px,3vw,32px)}
  .txt{padding:clamp(28px,4vw,52px) 0}
  :global(.big-logo){display:block;margin-bottom:12px}
  .brand h1{font-size:clamp(46px,7vw,92px);line-height:.95;letter-spacing:-.035em;margin:0 0 .12em}
  .lead{font:800 clamp(20px,2.5vw,32px)/1.12 var(--display);letter-spacing:-.02em;margin:0 0 12px}
  .sub{font-weight:600;font-size:clamp(15px,1.4vw,18px);color:var(--soft);margin:0}
  .cta{display:flex;gap:8px;flex-wrap:wrap}
  :global(.art){display:block;width:100%;height:100%;max-height:440px;object-fit:cover;object-position:30% 30%;align-self:end;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 22%);mask-image:linear-gradient(90deg,transparent,#000 22%)}

  .feat{padding-bottom:0}
  .feat-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(18px,3vw,36px);align-items:center;
    padding:clamp(14px,2vw,22px);border-radius:calc(var(--r) + 4px);background:var(--surface);border:1.5px solid var(--line)}
  .kicker{font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.08em;font-size:12px;margin:0 0 8px}
  .feat h2{font-size:clamp(22px,2.6vw,30px)}
  .lead2{color:var(--soft);margin:0 0 10px;max-width:50ch}
  .facts{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0 0 16px;font-weight:600;font-size:15px}
  .feat .primary{background:var(--cb);border-color:var(--cb);color:#fff}
  .screen{display:block;border-radius:var(--r);overflow:hidden;box-shadow:0 18px 40px color-mix(in srgb,var(--c) 28%,transparent),0 3px 10px rgba(0,0,0,.1)}

  .pick{padding-bottom:0}
  .pick h2{font-size:clamp(18px,1.8vw,22px)}
  .tiles{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,100px),1fr))}
  .tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:104px;padding:14px 8px;
    border-radius:16px;background:var(--surface);border:1.5px solid var(--line);text-decoration:none;text-align:center;
    transition:border-color 180ms var(--ease-out),background-color 180ms var(--ease-out),transform 160ms var(--ease-out)}
  @media (hover:hover) and (pointer:fine){ .tile:hover{border-color:var(--accent);background:var(--tint)} }
  .tile:active{transform:scale(.97)}
  .tile.empty b{color:var(--soft);opacity:.7}
  .tile b{font:800 clamp(40px,5vw,52px)/1 var(--display);color:var(--accent);letter-spacing:-.03em}
  .tile span{font-weight:700;font-size:16px;color:var(--soft)}

  .shelf{padding-bottom:0}
  .head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .head h2{margin:0;font-size:clamp(18px,1.8vw,22px)}
  .head a{font-weight:600;font-size:15px;color:var(--accent);text-decoration:none}
  @media (pointer:coarse){ .head a{display:inline-flex;align-items:center;min-height:44px} .tile{min-height:56px} }

  @media (max-width:820px){
    .brand-in{grid-template-columns:1fr}
    .txt{padding-bottom:0}
    :global(.big-logo){display:none}
    :global(.art){max-height:210px;-webkit-mask-image:linear-gradient(180deg,transparent,#000 25%);mask-image:linear-gradient(180deg,transparent,#000 25%)}
    .feat-in{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){ .tile{transition:border-color 180ms linear} .tile:active{transform:none} }
</style>
