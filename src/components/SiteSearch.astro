---
const base = import.meta.env.BASE_URL;
const active = Astro.url.pathname === `${base}poisk/`;
---
<a class="search-link" href={`${base}poisk/`} aria-label="Поиск по темам" title="Поиск по темам" aria-current={active ? 'page' : undefined}>
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" /><path d="m13 13 4.25 4.25" stroke-linecap="round" /></svg>
</a>
<style>
  .search-link{flex:none;display:grid;place-items:center;width:40px;height:40px;border:1.5px solid var(--line);border-radius:50%;color:var(--ink);background:var(--surface);text-decoration:none;transition:border-color 160ms var(--ease-out)}
  .search-link[aria-current]{color:var(--accent);background:var(--tint);border-color:var(--accent)}
  @media(hover:hover) and (pointer:fine){.search-link:hover{border-color:var(--accent)}}
  @media(pointer:coarse){.search-link{width:44px;height:44px}}
  @media(prefers-reduced-motion:reduce){.search-link{transition:none}}
</style>
