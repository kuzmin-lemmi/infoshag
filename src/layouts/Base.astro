---
import '../styles/global.css';
import { SITE } from '../config';
import Logo from '../components/Logo.astro';
import Meta from '../components/Meta.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; }
const { title, description = SITE.tagline, image, noindex } = Astro.props;
const base = import.meta.env.BASE_URL;
const full = title ? `${title} — ${SITE.short}` : SITE.name;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <Meta title={full} description={description} image={image} noindex={noindex} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <!-- сохранённая тема применяется до отрисовки, чтобы страница не мигала -->
  <script is:inline>try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
  <a class="skip" href="#main">Перейти к содержимому</a>
  <header class="top">
    <div class="wrap bar">
      <a class="logo" href={base}><Logo size={38} /><span>{SITE.short}</span></a>
      <nav aria-label="Разделы">
        {[7, 8, 9].map(g => (
          <a href={`${base}klass/${g}/`} aria-current={path.includes(`/klass/${g}/`) ? 'page' : undefined}>{g === 9 ? '9 · ОГЭ' : `${g} класс`}</a>
        ))}
        <a href={`${base}catalog/?type=course`}>Курсы</a>
        <a href={`${base}catalog/`} aria-current={path.includes('/catalog') ? 'page' : undefined}>Каталог</a>
      </nav>
      <button class="theme" id="theme" type="button" aria-label="Тёмная тема" aria-pressed="false">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.75" /><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor" /></svg>
      </button>
    </div>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer>
    <div class="wrap foot">
      <span class="brand"><Logo size={28} /><b>{SITE.short}</b> · игры и тренажёры по информатике · © {new Date().getFullYear()} {SITE.author}</span>
      <span class="links">
        <a href={SITE.github}>GitHub</a>
        {SITE.vk && <a href={SITE.vk}>ВКонтакте</a>}
      </span>
    </div>
  </footer>
</body>
</html>
<script>
  // подсказка прокрутки меню на узком экране: затухание справа, пока справа есть скрытые пункты
  const nav = document.querySelector<HTMLElement>('header nav');
  if (nav) {
    const update = () => nav.classList.toggle('more', nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 2);
    const current = nav.querySelector<HTMLElement>('[aria-current]');
    if (current && nav.scrollWidth > nav.clientWidth) {
      nav.scrollLeft = current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2;
    }
    nav.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }

  // переключатель темы: по умолчанию тема системы, выбор запоминается (localStorage только для удобства)
  const btn = document.getElementById('theme') as HTMLButtonElement | null;
  if (btn) {
    const mq = matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => {
      const t = document.documentElement.dataset.theme;
      return t ? t === 'dark' : mq.matches;
    };
    const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
    btn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      sync();
    });
    mq.addEventListener('change', sync);
    sync();
  }
</script>
<style>
  .skip{position:absolute;left:12px;top:-60px;z-index:30;padding:.6em 1em;border-radius:10px;background:var(--ink);color:var(--bg);font-weight:700;text-decoration:none}
  .skip:focus{top:calc(8px + env(safe-area-inset-top,0px))}
  main:focus{outline:none}
  .top{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
  .bar{display:flex;align-items:center;justify-content:space-between;gap:16px;height:64px}
  .logo{display:flex;align-items:center;gap:10px;text-decoration:none;font:800 21px var(--display);letter-spacing:-.02em}
  .logo svg{flex:none}
  nav{position:relative;display:flex;gap:4px;flex-wrap:wrap}
  nav a{text-decoration:none;font-weight:600;padding:.4em .75em;border-radius:10px;color:var(--soft)}
  nav a{transition:color 160ms var(--ease-out),background-color 160ms var(--ease-out)}
  @media (hover:hover) and (pointer:fine){ nav a:hover{color:var(--ink);background:var(--tint)} }
  nav a[aria-current]{color:var(--accent);background:var(--tint)}
  .theme{flex:none;display:grid;place-items:center;width:40px;height:40px;padding:0;border-radius:50%;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;
    transition:border-color 160ms var(--ease-out),transform 160ms var(--ease-out)}
  @media (hover:hover) and (pointer:fine){ .theme:hover{border-color:var(--accent)} }
  .theme:active{transform:scale(.94)}
  .theme[aria-pressed="true"] svg{transform:scaleX(-1)}
  @media (pointer:coarse),(max-width:640px){
    .theme{width:44px;height:44px}
    nav a{min-height:44px;display:inline-flex;align-items:center}
    .links a{min-height:44px;display:inline-flex;align-items:center}
  }
  @media (prefers-reduced-motion:reduce){ .theme:active{transform:none} nav a,.theme{transition-timing-function:linear} }
  footer{border-top:1px solid var(--line);background:var(--surface);margin-top:40px;padding:24px 0 calc(24px + env(safe-area-inset-bottom,0px))}
  .foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;color:var(--soft);font-size:15px}
  .brand{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap}
  .brand b{color:var(--ink)}
  .links{display:flex;gap:16px;align-items:center}
  @media (max-width:640px){
    .logo span:last-child{display:none}
    nav{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;min-width:0;flex:1;justify-content:flex-start}
    nav::-webkit-scrollbar{display:none}
    nav.more{-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 32px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 32px),transparent)}
    nav a{padding:.35em .5em;font-size:15px;white-space:nowrap}
  }
</style>
